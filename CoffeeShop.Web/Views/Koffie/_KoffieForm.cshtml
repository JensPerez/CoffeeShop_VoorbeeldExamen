@model KoffieFormVm

<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

<input type="hidden" asp-for="Id" />

<div class="mb-3">
    <label asp-for="Naam" class="form-label fw-semibold">Naam</label>
    <input asp-for="Naam" class="form-control" />
    <span asp-validation-for="Naam" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Prijs" class="form-label fw-semibold">Prijs (€)</label>
    <input asp-for="Prijs" class="form-control" />
    <span asp-validation-for="Prijs" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Beschrijving" class="form-label fw-semibold">Beschrijving</label>
    <textarea asp-for="Beschrijving" class="form-control" rows="4"></textarea>
    <span asp-validation-for="Beschrijving" class="text-danger"></span>
</div>

<div class="mb-4">
    <label class="form-label fw-semibold">Ingrediënten</label>
    <span asp-validation-for="IngredientIds" class="text-danger d-block"></span>

    <div class="row row-cols-1 row-cols-md-2 g-3">
        @foreach (var categorie in Model.BeschikbareIngredienten.GroupBy(x => x.CategorieNaam))
        {
            <div class="col">
                <div class="p-3 border rounded-3 h-100">
                    <h6 class="fw-bold text-coffee">@categorie.Key</h6>
                    @foreach (IngredientVm ingredient in categorie)
                    {
                        string checkboxId = $"ingredient-{ingredient.Id}";
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="IngredientIds" id="@checkboxId"
                                   value="@ingredient.Id" checked="@Model.IngredientIds.Contains(ingredient.Id)" />
                            <label class="form-check-label" for="@checkboxId">
                                @ingredient.Naam
                                @if (ingredient.IsVegan)
                                {
                                    <span title="Vegan" style="font-size: 0.9rem;">🌱</span>
                                }
                            </label>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>
