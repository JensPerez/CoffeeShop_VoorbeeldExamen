@model BestellingFormVm

@{
    ViewData["Title"] = "Nieuwe bestelling";
}

<div class="container my-5">
    <div class="mb-4">
        <a asp-controller="Koffie" asp-action="Index" class="btn btn-outline-coffee">
            &larr; Terug naar de menukaart
        </a>
    </div>

    <div class="p-4 bg-cream rounded-3 shadow-sm">
        <h1 class="display-6 fw-bold text-coffee mb-4">Nieuwe bestelling</h1>

        <form asp-controller="Bestelling" asp-action="Create" method="post">
            <partial name="_BestellingForm" model="Model" />

            <button type="submit" class="btn btn-coffee btn-lg">Bestelling plaatsen</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
